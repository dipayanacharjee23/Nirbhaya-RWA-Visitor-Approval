rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return signedIn() && myProfile().role == role;
    }

    function isAdmin() {
      return isRole("admin");
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /residences/{residenceId} {
      allow read: if isRole("security") || isAdmin() ||
        (isRole("resident") &&
          (resource.data.residentUid == request.auth.uid ||
           residenceId == myProfile().residenceId));
      allow create, update, delete: if isAdmin();
    }

    match /visitorRequests/{requestId} {
      allow create: if isRole("security") &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == "pending" &&
        request.resource.data.residentUid is string;

      allow read: if isAdmin() ||
        (isRole("security") && resource.data.createdBy == request.auth.uid) ||
        (isRole("resident") && resource.data.residentUid == request.auth.uid);

      allow update: if isAdmin() ||
        (isRole("resident") &&
         resource.data.residentUid == request.auth.uid &&
         request.resource.data.residentUid == resource.data.residentUid &&
         request.resource.data.createdBy == resource.data.createdBy &&
         request.resource.data.status in ["approved", "rejected"] &&
         request.resource.data.decidedBy == request.auth.uid);

      allow delete: if isAdmin();
    }
  }
}